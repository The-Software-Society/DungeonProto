{
  "id": "intro",
  "letterbox": true,
  "steps": [
    { "type": "fade", "target": 1, "seconds": 0 },
    { "type": "camera", "pos": [0, 24, -46], "lookAt": [0, 1, -6], "seconds": 0 },
    { "type": "fade", "target": 0, "seconds": 2.0, "blocking": false },
    { "type": "subtitle", "text": "EMBERFALL", "seconds": 3.2, "blocking": false },
    { "type": "camera", "pos": [6, 5, -26], "lookAt": [1, 1.2, -10], "seconds": 5.0 },
    { "type": "subtitle", "text": "You wake in the plaza of Emberfall, the taste of ash on the wind.", "seconds": 4.2, "blocking": false },
    { "type": "wait", "seconds": 0.8 },

    { "type": "move", "actor": "Aldric", "pos": [3, 0, -11], "seconds": 3.0, "blocking": false },
    { "type": "camera", "pos": [-2.5, 2.2, -19], "lookAt": [2.2, 1.4, -11], "seconds": 3.2 },
    { "type": "subtitle", "text": "Aldric:  On your feet. The cobbles are no bed for the living.", "seconds": 3.8, "blocking": false },
    { "type": "face", "actor": "Aldric", "lookAt": [0, 0, -14] },
    { "type": "face", "actor": "player", "lookAt": [3, 0, -11] },

    { "type": "camera", "pos": [1.5, 2.0, -8.5], "lookAt": [3.0, 1.6, -11.5], "seconds": 3.6 },
    { "type": "subtitle", "text": "Aldric:  I am Aldric, warden of Emberfall. Once I was... something else. Now I keep this town from the dark.", "seconds": 5.0, "blocking": false },
    { "type": "anim", "actor": "Aldric", "state": "Cast" },

    { "type": "camera", "pos": [-1.0, 1.8, -10], "lookAt": [3.0, 1.5, -11.5], "seconds": 4.0 },
    { "type": "subtitle", "text": "Aldric:  South of the gate the forest chars, and the mountain smoulders. The volcano is waking, and its embers reach for us.", "seconds": 5.4, "blocking": false },
    { "type": "wait", "seconds": 0.4 },
    { "type": "subtitle", "text": "Aldric:  Someone must go down into the fire and end it. But not as you are now.", "seconds": 4.4, "blocking": false },

    { "type": "camera", "pos": [2.4, 1.6, -10.5], "lookAt": [0, 1.3, -14], "seconds": 3.6 },
    { "type": "subtitle", "text": "Aldric:  Take this — it is yours now. A blade, or the spark of magic. Choose what suits your hand.", "seconds": 4.6, "blocking": false },
    { "type": "anim", "actor": "player", "state": "Attack" },

    { "type": "camera", "pos": [0, 6.0, -24], "lookAt": [0, 1.4, 4], "seconds": 4.4 },
    { "type": "subtitle", "text": "Aldric:  Learn to fight. Learn to fish and to cook — a full belly wins more battles than a sharp sword.", "seconds": 5.0, "blocking": false },
    { "type": "wait", "seconds": 0.4 },
    { "type": "subtitle", "text": "Aldric:  The wilds ring the town; the lake lies northwest. Go. Live a little, before the fire calls you south.", "seconds": 5.2, "blocking": false },

    { "type": "wait", "seconds": 1.0 },
    { "type": "fade", "target": 1, "seconds": 1.0 },
    { "type": "fade", "target": 0, "seconds": 0.8 }
  ]
}
