{
  "id": "intro",
  "letterbox": true,
  "steps": [
    { "type": "fade", "target": 1, "seconds": 0 },
    { "type": "camera", "pos": [0, 22, -138], "lookAt": [0, 1, -115], "seconds": 0 },
    { "type": "fade", "target": 0, "seconds": 2.0, "blocking": false },
    { "type": "subtitle", "text": "EMBERFALL", "seconds": 3.2, "blocking": false },
    { "type": "camera", "pos": [3.5, 5, -125], "lookAt": [0, 1.2, -115], "seconds": 5.0 },
    { "type": "subtitle", "text": "You wake beneath the pines, the taste of ash on the wind.", "seconds": 4.2, "blocking": false },
    { "type": "wait", "seconds": 0.8 },

    { "type": "move", "actor": "Aldric", "pos": [2.4, 0, -112.5], "seconds": 3.0, "blocking": false },
    { "type": "camera", "pos": [-2.8, 2.2, -118.5], "lookAt": [1.4, 1.4, -114], "seconds": 3.2 },
    { "type": "subtitle", "text": "Aldric:  On your feet. The forest floor is no bed for the living.", "seconds": 3.8, "blocking": false },
    { "type": "face", "actor": "Aldric", "lookAt": [0, 0, -115] },
    { "type": "face", "actor": "player", "lookAt": [2.4, 0, -112.5] },

    { "type": "camera", "pos": [1.2, 2.0, -109.5], "lookAt": [2.6, 1.6, -113], "seconds": 3.6 },
    { "type": "subtitle", "text": "Aldric:  I am Aldric. Once I was... something else. Now I keep this quiet corner of a dying world.", "seconds": 5.0, "blocking": false },
    { "type": "anim", "actor": "Aldric", "state": "Cast" },

    { "type": "camera", "pos": [-1.5, 1.8, -111], "lookAt": [2.6, 1.5, -113], "seconds": 4.0 },
    { "type": "subtitle", "text": "Aldric:  Emberfall is falling. The dungeon beneath the hills spreads its rot a little further each night.", "seconds": 5.0, "blocking": false },
    { "type": "wait", "seconds": 0.4 },
    { "type": "subtitle", "text": "Aldric:  Someone must go down into the dark and end it. But not as you are now.", "seconds": 4.4, "blocking": false },

    { "type": "camera", "pos": [2.2, 1.6, -110.5], "lookAt": [0, 1.3, -115], "seconds": 3.6 },
    { "type": "subtitle", "text": "Aldric:  Take this — it is yours now. A blade, or the spark of magic. Choose what suits your hand.", "seconds": 4.6, "blocking": false },
    { "type": "anim", "actor": "player", "state": "Attack" },

    { "type": "camera", "pos": [0, 5.5, -122], "lookAt": [0, 1.2, -102], "seconds": 4.4 },
    { "type": "subtitle", "text": "Aldric:  Learn to fight. Learn to fish and to cook — a full belly wins more battles than a sharp sword.", "seconds": 5.0, "blocking": false },
    { "type": "wait", "seconds": 0.4 },
    { "type": "subtitle", "text": "Aldric:  The town of Emberfall lies north through the gate. Go. Live a little, before the dark calls you down.", "seconds": 5.0, "blocking": false },

    { "type": "wait", "seconds": 1.0 },
    { "type": "fade", "target": 1, "seconds": 1.0 },
    { "type": "fade", "target": 0, "seconds": 0.8 }
  ]
}
