# Copy to .env.local (gitignored) and fill in your own values. Never commit real keys.
# Only the optional asset-generation tools in tools/ use these; the game itself needs none.

# Meshy 3D generation (tools/meshy_pipeline.py, tools/fetch_refine.py)
MESHY_API_KEY=

# Google AI / Gemini API: TTS voice lines and Veo intro video
# (tools/tts_aldric.py, tools/veo_intro.py read this from the environment)
GOOGLE_AI_API=

# SayMotion (DeepMotion) text-to-motion (tools/saymotion_pipeline.py)
SAYMOTION_CLIENT_ID=
SAYMOTION_CLIENT_SECRET=
SAYMOTION_API_URL=
