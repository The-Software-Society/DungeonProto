  "steps": [
    { "type": "fade", "target": 1, "seconds": 0 },
    { "type": "move", "actor": "player", "pos": [0, 1, 194], "seconds": 0 },
    { "type": "hide", "actor": "player" },

    { "type": "video", "clip": "entry_isekai.mp4", "blocking": true },

    { "type": "camera", "pos": [6.0, 3.6, 187], "lookAt": [0, 1.6, 198], "seconds": 0 },
    { "type": "fade", "target": 0, "seconds": 2.2, "blocking": true },
    { "type": "subtitle", "text": "You come to beneath the pines, the smoke of a far mountain still on the air.", "seconds": 3.4, "blocking": true },

    { "type": "camera", "pos": [3.4, 2.0, 190], "lookAt": [0, 1.1, 194], "seconds": 3.0, "blocking": false },
    { "type": "subtitle", "text": "A shape gathers out of the falling embers, a shape that used to be you.", "seconds": 2.6, "blocking": false },
    { "type": "materialize", "actor": "player", "seconds": 2.6, "blocking": true },
    { "type": "wait", "seconds": 0.5 },

    { "type": "face", "actor": "Aldric", "lookAt": [0, 0, 194] },
    { "type": "anim", "actor": "Aldric", "state": "Hit" },
    { "type": "camera", "pos": [2.6, 1.9, 196.6], "lookAt": [0, 1.7, 200], "seconds": 5.0, "blocking": false },
    { "type": "subtitle", "text": "Aldric:  Stand easy. Easy now. You came out of the air itself, set down in my glade like a leaf off the wind.", "voice": "aldric_intro_01.wav", "seconds": 1, "blocking": true },

    { "type": "camera", "pos": [-1.6, 2.3, 201.4], "lookAt": [0.4, 1.3, 194.5], "seconds": 5.0, "blocking": false },
    { "type": "subtitle", "text": "Aldric:  And you carry the chill of the newly dead. Yet here you stand, breathing. That is no small thing, stranger.", "voice": "aldric_intro_02.wav", "seconds": 1, "blocking": true },

    { "type": "camera", "pos": [1.8, 1.9, 197.4], "lookAt": [0.2, 1.4, 200], "seconds": 4.4, "blocking": false },
    { "type": "subtitle", "text": "Aldric:  No matter. You are here, and you know nothing of this place. So let an old man teach you a little, while it is quiet.", "voice": "aldric_intro_03.wav", "seconds": 1, "blocking": true },

    { "type": "camera", "pos": [4.8, 2.2, 196], "lookAt": [0, 1.6, 199.5], "seconds": 5.0, "blocking": false },
    { "type": "subtitle", "text": "Aldric:  This is Emberfall. Real ground, real cold, real teeth waiting in the dark of it. Walk it carefully, and it may yet let you live.", "voice": "aldric_intro_04.wav", "seconds": 1, "blocking": true },

    { "type": "anim", "actor": "Aldric", "state": "Cast" },
    { "type": "camera", "pos": [2.0, 1.8, 197.6], "lookAt": [0.2, 1.5, 200], "seconds": 5.2, "blocking": false },
    { "type": "subtitle", "text": "Aldric:  Here. Take these, all of them. A blade, a wand and its focus, and a bow with a full quiver. They are yours now.", "voice": "aldric_intro_05.wav", "seconds": 1, "blocking": true },

    { "type": "camera", "pos": [0, 5.0, 188], "lookAt": [0, 1.4, 199], "seconds": 6.0, "blocking": false },
    { "type": "subtitle", "text": "Aldric:  I will not tell you which to carry. Learn which one answers your hand. Then come find me, and we will see what you are made of.", "voice": "aldric_intro_06.wav", "seconds": 1, "blocking": true },

    { "type": "wait", "seconds": 0.8 },
    { "type": "fade", "target": 1, "seconds": 1.4 },
    { "type": "fade", "target": 0, "seconds": 1.0 }
  ]
}
